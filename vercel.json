{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@10.32.1 --dir frontend install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.32.1 --dir frontend build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "backend/{app,data}/**",
      "excludeFiles": "{frontend/**,docs/**,.github/**,backend/.venv/**,backend/tests/**,backend/scripts/**,**/__pycache__/**,**/.pytest_cache/**,**/.ruff_cache/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
